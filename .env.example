# Copy to .env (or set these in your host's dashboard). NEVER commit real values.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Optional – use PostgreSQL (Neon, Supabase, Render, Railway...) when the host has no persistent disk:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Optional – folder for the SQLite file (point at a persistent disk/volume):
# DATA_DIR=/var/data
# Optional – fixed secret for session cookies (otherwise generated once and stored in the DB):
# SESSION_SECRET=
# Set to 1 when running behind a reverse proxy/CDN (Render, Railway, Nginx...) so login rate-limits use the real client IP:
# TRUST_PROXY=1
# PORT=3000
